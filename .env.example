# ==============================================================================
# FollowersPlan — Environment Variables Template
# Copy this file to .env and replace placeholder values with your real keys.
# ==============================================================================

# Instagram Session ID Cookie (Recommended method, 100% ban-proof)
INSTAGRAM_SESSION_ID="add your sessionid here"

# Instagram Username & Password (Alternative direct login method)
INSTAGRAM_USERNAME="add your username here"
INSTAGRAM_PASSWORD="add your password here"

# Meta Graph API Credentials (Optional)
META_APP_ID="add your app id here"
META_APP_SECRET="add your app secret here"
META_ACCESS_TOKEN="add your token here"

# Notifications (Optional: Alerts when people unfollow your account)
DISCORD_WEBHOOK_URL="add your discord webhook url here"
TELEGRAM_BOT_TOKEN="add your telegram bot token here"
TELEGRAM_CHAT_ID="add your telegram chat id here"

# Proxy (Optional: For cloud data-center deployment)
INSTAGRAM_PROXY="add your proxy here (optional)"

# Anti-ban delay in seconds between unfollow actions (Default: 6.0)
DEFAULT_UNFOLLOW_DELAY_SECONDS=6.0
MAX_UNFOLLOWS_PER_BATCH=40

# Server Port and Host
PORT=5000
HOST="0.0.0.0"
SECRET_KEY="add your secret key here"
